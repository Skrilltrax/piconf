{
  "$schema": "https://pi.dev/schema/settings.json",

  "defaultProvider": "zai",
  "defaultModel": "glm-5.2",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,

  "theme": "dark",

  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },

  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },

  "enabledModels": ["claude-*", "gpt-4o", "gemini-2*", "glm-*"],

  "enableSkillCommands": true,

  "packages": []
}
